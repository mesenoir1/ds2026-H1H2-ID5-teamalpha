{
  "architecture": "DenseNet201",
  "loss": "DynamicLabelSmoothingLoss",
  "max_alpha": 0.5,
  "augmentations": [
    "HorizontalFlip",
    "Inversion (p=0.5)",
    "GaussianNoise (std=0.05)"
  ],
  "intervention": "dynamic ROI-guided background blur",
  "suppression_probability": 0.5,
  "blur_kernel": 21,
  "epochs": 30,
  "batch_size": 8,
  "learning_rate": 0.0001,
  "seed": 42
}